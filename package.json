{
  "name": "native-federation-vite",
  "version": "0.3.0",
  "description": "Vite plugin that generates a remoteEntry.json compatible with @angular-architects/native-federation, letting Vite remotes (Vue/React/Svelte/Solid) be federated by an Angular shell.",
  "type": "module",
  "license": "MIT",
  "author": "Jonathan Ferreira <dom.ai.jonathan@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonmferreira/native-federation-vite.git"
  },
  "homepage": "https://github.com/jonmferreira/native-federation-vite#readme",
  "bugs": "https://github.com/jonmferreira/native-federation-vite/issues",
  "keywords": [
    "vite",
    "vite-plugin",
    "native-federation",
    "module-federation",
    "microfrontend",
    "micro-frontend",
    "mfe",
    "angular",
    "vue",
    "react",
    "remoteEntry"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "native-federation-vite": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "guard": "node scripts/guard.mjs",
    "prepublishOnly": "npm run guard && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@softarc/native-federation": "~4.8.1",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@softarc/native-federation": "^4.7.1",
    "@softarc/native-federation-esbuild": "^4.2.0",
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
